# Copy to .env at the repository root.
MONGO_URI=mongodb://127.0.0.1:27017/chronotime
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=9000
NODE_ENV=development
# Optional browser origins when frontend and API are on different hosts.
# Also list the public HTTPS origin here when TLS terminates at a reverse proxy.
ALLOWED_ORIGINS=
